{
  "compilerOptions": {
    "target": "ES2020",
    "module": "None",
    "strict": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["chrome"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
